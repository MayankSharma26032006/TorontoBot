# ── OpenAI ─────────────────────────────────────────────────────
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ── Pinecone ───────────────────────────────────────────────────
# Get a key: https://app.pinecone.io  →  API Keys  →  Create API Key
PINECONE_API_KEY=pc-your-key-here

# ── Optional ───────────────────────────────────────────────────
# OpenAI chat model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Pinecone serverless cloud / region (defaults: aws / us-east-1)
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
